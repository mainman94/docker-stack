{
  "name": "docker-stack",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    // docker-in-docker rather than -outside-of-docker: `make validate` and the
    // compose-config hook need a daemon, and an isolated one keeps a stray
    // `make up` from touching the host's real stacks.
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "version": "latest",
      "dockerDashComposeVersion": "v2"
    },
    // python, pre-commit, trivy, jq, actionlint and shellcheck are not
    // features any more: mise.toml pins them and post-create runs
    // `mise install`. One version list, shared with CI.
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml",
        "timonwong.shellcheck",
        "foxundermoon.shell-format",
        "mkhl.direnv"
      ],
      "settings": {
        "files.insertFinalNewline": true,
        "files.trimTrailingWhitespace": true,
        "[shellscript]": { "editor.tabSize": 2 },
        "yaml.format.enable": false
      }
    }
  }
}
