BACKUP_CRON_EXPRESSION=30 3 * * *
BACKUP_RETENTION_DAYS=7
BACKUP_ARCHIVE=/archive
TZ=Europe/Vienna
UNHEALTHY_RESTART_INTERVAL_SECONDS=60

# Host-Pfad unter dem die Backup-Archive pro Service abgelegt werden
BACKUP_ROOT=/mnt/default_pool/dockge/back

# Stack-Wurzelverzeichnisse (enthalten docker-compose.yaml und .env)
STACKS_ROOT=/mnt/default_pool/dockge/stacks/Production

ADGUARD_HOME_STACK_HOST_PATH=/mnt/default_pool/dockge/stacks/Production/adguard-home
