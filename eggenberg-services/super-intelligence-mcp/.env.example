# Copy to .env and fill in. Never commit .env.
SUPER_INTELLIGENCE_MCP_TZ=Europe/Vienna

SUPER_INTELLIGENCE_MCP_WEB_PORT=30678

SUPER_INTELLIGENCE_MCP_DATA_HOST_PATH=./super-intelligence-mcp/data
SUPER_INTELLIGENCE_MCP_SECRETS_HOST_PATH=./super-intelligence-mcp/secrets

SUPER_INTELLIGENCE_MCP_CPUS=1
SUPER_INTELLIGENCE_MCP_MEM_LIMIT=512m

# --- app config (passed through via env_file) ---
REPO_URL=https://github.com/mainman94/super-intelligence.git
REPO_BRANCH=main

# Either HTTPS token (fine-grained PAT, contents rw on super-intelligence)...
GIT_TOKEN=
# GIT_TOKEN_FILE=/secrets/git_token
# ...or an SSH deploy key with write access (then use the git@github.com: URL):
# REPO_URL=git@github.com:mainman94/super-intelligence.git
# GIT_SSH_KEY_PATH=/secrets/deploy_key

GIT_AUTHOR_NAME=super-intelligence-mcp
GIT_AUTHOR_EMAIL=super-intelligence-mcp@users.noreply.github.com

# For propose_change pull requests (defaults to GIT_TOKEN)
GITHUB_TOKEN=
# GITHUB_TOKEN_FILE=/secrets/github_token

TOKENS_FILE=/secrets/tokens.yaml

PUBLIC_BASE_URL=https://simcp.hauptmann.dev

# Pocket ID OAuth (claude.ai / iOS). Client: homelab/terraform/pocket-id. Leave unset for bearer tokens only.
OIDC_CONFIG_URL=https://id.hauptmann.dev/.well-known/openid-configuration
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET_FILE=/secrets/oidc_client_secret
FASTMCP_HOME=/data/fastmcp
PORT=8080
SYNC_INTERVAL_SECONDS=300
LOG_LEVEL=INFO
