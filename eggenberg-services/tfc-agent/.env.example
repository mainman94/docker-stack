TFC_AGENT_TZ=Europe/Vienna

# --- HCP Terraform / Terraform Cloud agent ---
# Agent pool token from app.terraform.io → Settings → Agents.
TFC_AGENT_TOKEN=change-me
TFC_AGENT_NAME=eggenberg
TFC_ADDRESS=https://app.terraform.io

TFC_AGENT_CPUS=1
# 2g, not 512m: the agent runs `terraform init`, which downloads and unpacks
# provider binaries a few hundred MB in size. 512m leaves no headroom for
# that; this is sizing, not a fix for any specific failure.
TFC_AGENT_MEM_LIMIT=2g
