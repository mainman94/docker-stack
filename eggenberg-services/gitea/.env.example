
GITEA_UID=568
GITEA_GID=568
GITEA_TZ=Europe/Vienna

GITEA_DOMAIN=gitea.example.invalid
GITEA_ROOT_URL=https://gitea.example.invalid/
GITEA_WEB_PORT=30056
GITEA_SSH_PORT=30057

# OpenID sign-in/sign-up. Set SIGNIN=false to disable OpenID entirely.
GITEA_ENABLE_OPENID_SIGNIN=false
GITEA_ENABLE_OPENID_SIGNUP=false
# Empty = allow all. POSIX regex, comma/space separated.
GITEA_OPENID_WHITELISTED_URIS=
GITEA_OPENID_BLACKLISTED_URIS=

GITEA_DATA_HOST_PATH=./gitea/data
GITEA_DATA_CONTAINER_PATH=/data
GITEA_CPUS=2
GITEA_MEM_LIMIT=2048m

GITEA_POSTGRES_DATABASE=gitea
GITEA_POSTGRES_USER=gitea
GITEA_POSTGRES_PASSWORD=change-me
GITEA_POSTGRES_DATA_HOST_PATH=./gitea/postgres-data
GITEA_POSTGRES_CPUS=1
GITEA_POSTGRES_MEM_LIMIT=1024m

# Gitea Actions + act_runner (dind).
GITEA_ACTIONS_ENABLED=true
# Public URL — must be reachable from BOTH the runner container AND the
# DinD-spawned job containers. Jobs run inside the DinD daemon (off
# gitea_network), so an internal http://gitea:3000 makes actions/checkout hang
# on fetch. The registry push already targets git.hauptmann.dev, so jobs need
# public reachability anyway; keep clone + registry on the same route.
GITEA_RUNNER_INSTANCE_URL=https://git.hauptmann.dev
# One-time registration token: Gitea > Site Admin > Actions > Runners > Create.
GITEA_RUNNER_REGISTRATION_TOKEN=change-me
GITEA_RUNNER_NAME=eggenberg-runner
GITEA_RUNNER_LABELS=ubuntu-latest:docker://catthehacker/ubuntu:act-latest
GITEA_RUNNER_DATA_HOST_PATH=./gitea/runner-data
GITEA_RUNNER_CERTS_HOST_PATH=./gitea/runner-certs
GITEA_RUNNER_CPUS=2
GITEA_RUNNER_MEM_LIMIT=2048m
GITEA_RUNNER_DIND_CPUS=2
GITEA_RUNNER_DIND_MEM_LIMIT=2048m
