
GITEA_UID=568
GITEA_GID=568
GITEA_TZ=Europe/Vienna

GITEA_DOMAIN=gitea.example.invalid
GITEA_ROOT_URL=https://gitea.example.invalid/
GITEA_WEB_PORT=30056
GITEA_SSH_PORT=30057

# OpenID sign-in/sign-up. Set SIGNIN=false to disable OpenID entirely.
GITEA_ENABLE_OPENID_SIGNIN=false
GITEA_ENABLE_OPENID_SIGNUP=false
# Empty = allow all. POSIX regex, comma/space separated.
GITEA_OPENID_WHITELISTED_URIS=
GITEA_OPENID_BLACKLISTED_URIS=

GITEA_DATA_HOST_PATH=./gitea/data
GITEA_DATA_CONTAINER_PATH=/data
GITEA_CPUS=2
GITEA_MEM_LIMIT=2048m

GITEA_POSTGRES_DATABASE=gitea
GITEA_POSTGRES_USER=gitea
GITEA_POSTGRES_PASSWORD=change-me
GITEA_POSTGRES_DATA_HOST_PATH=./gitea/postgres-data
GITEA_POSTGRES_CPUS=1
GITEA_POSTGRES_MEM_LIMIT=1024m
