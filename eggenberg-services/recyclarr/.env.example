RECYCLARR_UID=568
RECYCLARR_GID=568
RECYCLARR_TZ=Europe/Vienna

# Cron schedule for automatic `recyclarr sync` runs (default daily).
RECYCLARR_CRON_SCHEDULE=@daily

# Sonarr/Radarr reached via host-published ports (same pattern as seerr).
# Replace <HOST_IP> with the Docker host address.
RECYCLARR_SONARR_BASE_URL=http://<HOST_IP>:30113
RECYCLARR_SONARR_API_KEY=changeme
RECYCLARR_RADARR_BASE_URL=http://<HOST_IP>:30025
RECYCLARR_RADARR_API_KEY=changeme

# Host path is relative to the compose file's directory. Under Dockge each stack
# runs from its own dir (…/stacks/Production/recyclarr), so this must be ./config
# — NOT ./recyclarr/config, which would resolve to …/recyclarr/recyclarr/config
# (empty) and recyclarr would scaffold a fresh, config-less /config.
RECYCLARR_CONFIG_HOST_PATH=./config
RECYCLARR_CONFIG_CONTAINER_PATH=/config

RECYCLARR_CPUS=0.5
RECYCLARR_MEM_LIMIT=256m
