SABNZBD_UID=568
SABNZBD_GID=568
SABNZBD_TZ=Europe/Vienna

SABNZBD_WEB_PORT=30670

SABNZBD_CONFIG_HOST_PATH=./sabnzbd/config
SABNZBD_CONFIG_CONTAINER_PATH=/config

SABNZBD_DOWNLOADS_HOST_PATH=/mnt/default_pool/Downloads
SABNZBD_DOWNLOADS_CONTAINER_PATH=/downloads

# SAB categories tv/series -> /Series/.downloads, movies -> /movies/.downloads.
# .downloads sits next to library/ (the Sonarr/Radarr root folders are
# /Series/library and /movies/library), never inside it.
# Create the host folders as uid/gid 568 before the first deploy, each with an
# empty .ignore file so Jellyfin skips them.
SABNZBD_SERIES_COMPLETE_HOST_PATH=/mnt/default_pool/Series/.downloads
SABNZBD_SERIES_COMPLETE_CONTAINER_PATH=/Series/.downloads
SABNZBD_MOVIES_COMPLETE_HOST_PATH=/mnt/default_pool/Movies/.downloads
SABNZBD_MOVIES_COMPLETE_CONTAINER_PATH=/movies/.downloads

SABNZBD_CPUS=2
SABNZBD_MEM_LIMIT=2048m
