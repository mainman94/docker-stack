# =========================================================================
# TEIL 0: HOST-PFADE
# =========================================================================
FIREFLY_III_DB_HOST_PATH=./firefly-iii/db
FIREFLY_III_UPLOAD_HOST_PATH=./firefly-iii/upload

# =========================================================================
# TEIL 1: DATENBANK (MariaDB)
# =========================================================================
MYSQL_RANDOM_ROOT_PASSWORD=yes
MYSQL_USER=firefly
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=firefly

# =========================================================================
# TEIL 2: FIREFLY III CORE (Haupt-App)
# =========================================================================
APP_NAME=FireflyIII
APP_ENV=local
# Laravel App-Key: exakt 32 zufällige Zeichen, verschlüsselt Daten in der DB.
# Lokal generieren mit:
#   head /dev/urandom | LC_ALL=C tr -dc 'A-Za-z0-9' | head -c 32; echo
APP_KEY=change-me-to-32-random-characters
APP_DEBUG=false
SITE_OWNER=mail@example.com
TZ=Europe/Berlin
TRUSTED_PROXIES=**
APP_URL=http://192.168.0.129:30666
APP_PORT=30666

# Datenbank-Verbindung
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=firefly
DB_USERNAME=firefly
DB_PASSWORD=change_me

# Cron
STATIC_CRON_TOKEN=replace_with_32_random_characters

# Standardwerte
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# =========================================================================
# TEIL 3: DATA IMPORTER
# =========================================================================
FIREFLY_III_URL=http://app:8080
VANITY_URL=http://192.168.0.129:30666
IMPORTER_PORT=30667
FIREFLY_III_ACCESS_TOKEN=replace_with_firefly_access_token
SEND_TELEMETRY=false
