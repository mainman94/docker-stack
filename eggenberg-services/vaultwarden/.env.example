VAULTWARDEN_TZ=Europe/Vienna

VAULTWARDEN_UID=568
VAULTWARDEN_GID=568

# --- Vaultwarden ---
VAULTWARDEN_DOMAIN=https://vault.example.invalid
VAULTWARDEN_WEB_PORT=30032

VAULTWARDEN_DATA_HOST_PATH=./vaultwarden/data
VAULTWARDEN_CPUS=1
VAULTWARDEN_MEM_LIMIT=512m

# Admin token as Argon2 hash:
# docker run --rm -it vaultwarden/server /vaultwarden hash --preset owasp
VAULTWARDEN_ADMIN_TOKEN=change-me

VAULTWARDEN_SIGNUPS_ALLOWED=false
VAULTWARDEN_INVITATIONS_ALLOWED=true

# --- PostgreSQL ---
VAULTWARDEN_POSTGRES_DATABASE=vaultwarden
VAULTWARDEN_POSTGRES_USER=vaultwarden
VAULTWARDEN_POSTGRES_PASSWORD=change-me
VAULTWARDEN_POSTGRES_DATA_HOST_PATH=./vaultwarden/postgres-data
VAULTWARDEN_POSTGRES_CPUS=1
VAULTWARDEN_POSTGRES_MEM_LIMIT=512m

# --- SMTP ---
VAULTWARDEN_SMTP_HOST=smtp.example.invalid
VAULTWARDEN_SMTP_PORT=587
VAULTWARDEN_SMTP_SECURITY=starttls
VAULTWARDEN_SMTP_USERNAME=vaultwarden@example.invalid
VAULTWARDEN_SMTP_PASSWORD=change-me
VAULTWARDEN_SMTP_FROM=vaultwarden@example.invalid
VAULTWARDEN_SMTP_FROM_NAME=Vaultwarden
