OPENGYM_UID=568
OPENGYM_GID=568
TZ=Europe/Vienna
OPENGYM_WEB_PORT=30781

OPENGYM_DATA_HOST_PATH=./opengym/data
OPENGYM_MEDIA_IMG_HOST_PATH=./opengym/media/img
OPENGYM_MEDIA_GIF_HOST_PATH=./opengym/media/gif

# Passkey / WebAuthn — must match the public URL served by the gateway.
OPENGYM_RP_ID=exercise.hauptmann.dev
OPENGYM_ORIGIN=https://exercise.hauptmann.dev
OPENGYM_RP_NAME=openGym
# Require invite codes to register — no open profile creation.
OPENGYM_INVITE_ONLY=1
# Comma-separated user IDs allowed to mint invites / admin. Fill after first user registers.
OPENGYM_ADMIN_UIDS=
OPENGYM_ALLOW_GUEST=0

OPENGYM_API_CPUS=1
OPENGYM_API_MEM_LIMIT=512m
OPENGYM_WEB_CPUS=1
OPENGYM_WEB_MEM_LIMIT=256m
