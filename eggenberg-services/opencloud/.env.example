OPENCLOUD_TZ=Europe/Vienna

OPENCLOUD_UID=568
OPENCLOUD_GID=568

# --- OpenCloud ---
# TLS terminated by Cilium Gateway; this must still be the public HTTPS URL
OPENCLOUD_URL=https://cloud.hauptmann.dev
# Domain only (no protocol) — used by Collabora CSP and frame_ancestors
OPENCLOUD_OC_DOMAIN=cloud.hauptmann.dev
OPENCLOUD_WEB_PORT=30080

# Set before first start — cannot be changed via env after initialisation
OPENCLOUD_ADMIN_PASSWORD=change-me

OPENCLOUD_LOG_LEVEL=info
OPENCLOUD_DEFAULT_LANGUAGE=de

# Comma-separated list of optional services to enable, e.g. "notifications,antivirus"
OPENCLOUD_ADDITIONAL_SERVICES=

OPENCLOUD_CONFIG_HOST_PATH=./opencloud/config-data
OPENCLOUD_DATA_HOST_PATH=./opencloud/data

OPENCLOUD_CPUS=2
OPENCLOUD_MEM_LIMIT=2048m

# --- SMTP (add 'notifications' to OPENCLOUD_ADDITIONAL_SERVICES to enable) ---
OPENCLOUD_SMTP_HOST=
OPENCLOUD_SMTP_PORT=587
OPENCLOUD_SMTP_SENDER=OpenCloud <noreply@hauptmann.dev>
OPENCLOUD_SMTP_USERNAME=
OPENCLOUD_SMTP_PASSWORD=
OPENCLOUD_SMTP_AUTHENTICATION=plain
OPENCLOUD_SMTP_ENCRYPTION=starttls

# --- Collabora (online office editor) ---
OPENCLOUD_COLLABORA_DOMAIN=collabora.hauptmann.dev
OPENCLOUD_COLLABORA_PORT=30082
OPENCLOUD_COLLABORA_ADMIN_USER=admin
OPENCLOUD_COLLABORA_ADMIN_PASSWORD=change-me
OPENCLOUD_COLLABORA_CPUS=2
OPENCLOUD_COLLABORA_MEM_LIMIT=2048m

# --- Collaboration / WOPI server ---
OPENCLOUD_WOPISERVER_DOMAIN=wopiserver.hauptmann.dev
OPENCLOUD_WOPISERVER_PORT=30081
OPENCLOUD_COLLABORATION_CPUS=1
OPENCLOUD_COLLABORATION_MEM_LIMIT=512m
