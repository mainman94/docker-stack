# Open WebUI + LiteLLM + mem0
#
# First-time setup order:
#   1. Copy this file to .env and replace every "change-me":
#        openssl rand -base64 48
#   2. Set MEM0_REF to a release tag (never "main") and check the image tags
#      in the compose file against the current releases.
#   3. Create the data directories and chown them to 568:568 (Postgres runs as
#      its own image user and does not need it):
#        mkdir -p open-webui/data open-webui/postgres-data redis/data
#        chown -R 568:568 open-webui/data redis/data
#   4. docker compose up -d
#   5. Open the web UI, create the first user — that one becomes admin.
#      Then set OPEN_WEBUI_ENABLE_SIGNUP=false and restart.
#   6. Open the mem0 dashboard on OPEN_WEBUI_MEM0_PORT, create the admin
#      account, generate an API key.
#   7. Memory comes in two halves, both need the same API key in their valves:
#        Admin Panel -> Functions -> paste mem0_filter.py, enable it, assign
#          it to the model. It injects a short index once per chat and records
#          each finished turn.
#        Workspace -> Tools -> paste mem0_tool.py. Then Workspace -> Models ->
#          claude-opus -> tick the tool, and set Advanced Params ->
#          Function Calling to "Native" so the tool definition goes to the
#          provider instead of being described in the prompt.
#      Do NOT put the tool on task-model: it only writes chat titles and tags,
#      it never needs memory.
#      Note: litellm-config.yaml sets drop_params: true. Tool definitions sent
#      to a model that cannot call tools are dropped silently — no error, the
#      model just never calls it. First place to look if a tool "does nothing".
#   8. Admin Panel -> Interface: set the task model to "task-model". Otherwise
#      the expensive main model generates every chat title.

OPEN_WEBUI_TZ=Europe/Vienna
OPEN_WEBUI_UID=568
OPEN_WEBUI_GID=568
OPEN_WEBUI_REDIS_UID=568
OPEN_WEBUI_REDIS_GID=568

OPEN_WEBUI_WEB_PORT=30081
OPEN_WEBUI_MEM0_PORT=30082
# External URL behind the reverse proxy.
OPEN_WEBUI_URL=https://chat.hauptmann.dev

# Set to false once the admin account exists, then restart.
OPEN_WEBUI_ENABLE_SIGNUP=true

# --- Secrets ------------------------------------------------------------
OPEN_WEBUI_SECRET_KEY=change-me
OPEN_WEBUI_POSTGRES_USER=aistack
OPEN_WEBUI_POSTGRES_PASSWORD=change-me
# Router master key. Doubles as Open WebUI's OPENAI_API_KEY against LiteLLM.
OPEN_WEBUI_LITELLM_MASTER_KEY=sk-change-me
# Encrypts the provider keys stored in the DB. Do NOT change it after the
# first start — the stored keys become unreadable.
OPEN_WEBUI_LITELLM_SALT_KEY=change-me
OPEN_WEBUI_MEM0_JWT_SECRET=change-me

# --- Provider keys (only fill in what is used) --------------------------
OPEN_WEBUI_ANTHROPIC_API_KEY=change-me
OPEN_WEBUI_OPENAI_API_KEY=change-me
OPEN_WEBUI_OPENROUTER_API_KEY=change-me
OPEN_WEBUI_GEMINI_API_KEY=change-me

# --- RAG embeddings (API instead of a local model) ----------------------
OPEN_WEBUI_RAG_EMBEDDING_MODEL=text-embedding-3-small
OPEN_WEBUI_RAG_EMBEDDING_BASE_URL=https://api.openai.com/v1
OPEN_WEBUI_RAG_EMBEDDING_API_KEY=change-me

# --- mem0 ---------------------------------------------------------------
# Release tag from github.com/mem0ai/mem0/releases. Renovate does not track
# this — read the release notes before every bump.
OPEN_WEBUI_MEM0_REF=v0.1.118
# Extraction LLM: runs on every turn, hence deliberately small.
OPEN_WEBUI_MEM0_LLM_BASE_URL=https://api.openai.com/v1
OPEN_WEBUI_MEM0_LLM_API_KEY=change-me
OPEN_WEBUI_MEM0_LLM_MODEL=gpt-5-mini
OPEN_WEBUI_MEM0_EMBEDDER_MODEL=text-embedding-3-small

# --- Persistent data ----------------------------------------------------
# PG18 keeps its cluster under 18/docker inside this directory.
OPEN_WEBUI_POSTGRES_DATA_HOST_PATH=./open-webui/postgres-data
OPEN_WEBUI_REDIS_DATA_HOST_PATH=./redis/data
# Uploaded files and the function sources.
OPEN_WEBUI_DATA_HOST_PATH=./open-webui/data

# --- Limits -------------------------------------------------------------
OPEN_WEBUI_CPUS=2
OPEN_WEBUI_MEM_LIMIT=2048m

OPEN_WEBUI_POSTGRES_CPUS=1
OPEN_WEBUI_POSTGRES_MEM_LIMIT=1024m

OPEN_WEBUI_REDIS_CPUS=0.5
OPEN_WEBUI_REDIS_MEM_LIMIT=384m

OPEN_WEBUI_LITELLM_CPUS=1
OPEN_WEBUI_LITELLM_MEM_LIMIT=1024m

OPEN_WEBUI_MEM0_CPUS=1
OPEN_WEBUI_MEM0_MEM_LIMIT=1024m
