# Open WebUI + LiteLLM
#
# First-time setup order:
#   1. Copy this file to .env and replace every "change-me":
#        openssl rand -base64 48
#   2. Check the image tags in the compose file against the current releases.
#   3. Create the data directories and chown them to 568:568 (Postgres runs as
#      its own image user and does not need it):
#        mkdir -p open-webui/data open-webui/postgres-data open-webui/redis-data
#        chown -R 568:568 open-webui/redis-data
#   4. docker compose up -d
#   5. Open the web UI, create the first user — that one becomes admin.
#      Then set OPEN_WEBUI_ENABLE_SIGNUP=false and restart.
#   6. Admin Panel -> Interface: set the task model to "task-model". Otherwise
#      the expensive main model generates every chat title.
#   7. Code sandbox: Admin Settings -> connect Open Terminal at
#        http://open-webui-terminal:8000
#      with OPEN_WEBUI_TERMINAL_API_KEY. No host port is published; Open WebUI
#      reaches it over the stack network.

OPEN_WEBUI_TZ=Europe/Vienna
OPEN_WEBUI_REDIS_UID=568
OPEN_WEBUI_REDIS_GID=568

OPEN_WEBUI_WEB_PORT=30081
# External URL behind the reverse proxy.
OPEN_WEBUI_URL=https://chat.hauptmann.dev

# Set to false once the admin account exists, then restart.
OPEN_WEBUI_ENABLE_SIGNUP=true

# --- Secrets ------------------------------------------------------------
OPEN_WEBUI_SECRET_KEY=change-me
OPEN_WEBUI_POSTGRES_USER=aistack
OPEN_WEBUI_POSTGRES_PASSWORD=change-me
# Router master key. Doubles as Open WebUI's OPENAI_API_KEY against LiteLLM.
OPEN_WEBUI_LITELLM_MASTER_KEY=sk-change-me
# Encrypts the provider keys stored in the DB. Do NOT change it after the
# first start — the stored keys become unreadable.
OPEN_WEBUI_LITELLM_SALT_KEY=change-me
# Open Terminal auth. Pin it — an autogenerated key changes on every restart.
OPEN_WEBUI_TERMINAL_API_KEY=change-me

# --- Provider keys (only fill in what is used) --------------------------
OPEN_WEBUI_ANTHROPIC_API_KEY=change-me
OPEN_WEBUI_OPENAI_API_KEY=change-me
OPEN_WEBUI_OPENROUTER_API_KEY=change-me
# Groq free tier: 30 req/min, no card required. console.groq.com/keys
OPEN_WEBUI_GROQ_API_KEY=change-me
OPEN_WEBUI_GEMINI_API_KEY=change-me

# --- RAG embeddings (API instead of a local model) ----------------------
OPEN_WEBUI_RAG_EMBEDDING_MODEL=text-embedding-3-small
OPEN_WEBUI_RAG_EMBEDDING_BASE_URL=https://api.openai.com/v1
OPEN_WEBUI_RAG_EMBEDDING_API_KEY=change-me

# --- Persistent data ----------------------------------------------------
# Mounted at PGDATA (/var/lib/postgresql/data) — see the compose comment.
OPEN_WEBUI_POSTGRES_DATA_HOST_PATH=./open-webui/postgres-data
OPEN_WEBUI_REDIS_DATA_HOST_PATH=./open-webui/redis-data
# Uploaded files and the function sources.
OPEN_WEBUI_DATA_HOST_PATH=./open-webui/data
# Working directory of the code sandbox. Anything the model writes lands here.
OPEN_WEBUI_TERMINAL_HOME_HOST_PATH=./open-webui/terminal-home

# --- Limits -------------------------------------------------------------
OPEN_WEBUI_CPUS=2
OPEN_WEBUI_MEM_LIMIT=2048m

OPEN_WEBUI_POSTGRES_CPUS=1
OPEN_WEBUI_POSTGRES_MEM_LIMIT=1024m

OPEN_WEBUI_REDIS_CPUS=0.5
OPEN_WEBUI_REDIS_MEM_LIMIT=384m

OPEN_WEBUI_LITELLM_CPUS=1
OPEN_WEBUI_LITELLM_MEM_LIMIT=1024m

OPEN_WEBUI_TERMINAL_CPUS=2
OPEN_WEBUI_TERMINAL_MEM_LIMIT=2048m
