# =========================================================================
# STRAPI CONFIGURATION
# =========================================================================

# Timezone
STRAPI_TZ=Europe/Vienna

# UID/GID for the container user (run `id` to get your current user's UID/GID)
STRAPI_UID=568
STRAPI_GID=568

# Web port for Strapi admin API
STRAPI_WEB_PORT=30668

# Strapi application port (inside container)
STRAPI_PORT=1337

# Strapi node environment
STRAPI_NODE_ENV=production

# Strapi host binding
STRAPI_HOST=0.0.0.0

# =========================================================================
# DATABASE (PostgreSQL)
# =========================================================================

STRAPI_DATABASE_CLIENT=postgres
STRAPI_DATABASE_HOST=db
STRAPI_DATABASE_PORT=5432
STRAPI_DATABASE=strapi
STRAPI_DB_USER=strapi
STRAPI_DB_PASSWORD=change_me
STRAPI_DATABASE_SSL=false

# =========================================================================
# SECURITY SECRETS (Generate with: openssl rand -base64 32)
# =========================================================================

# App keys - comma-separated list of base64 strings (at least 4 keys recommended)
# Generate with: openssl rand -base64 32
STRAPI_APP_KEYS=change_me_key1,change_me_key2,change_me_key3,change_me_key4

# JWT secrets
STRAPI_API_TOKEN_SALT=change_me
STRAPI_ADMIN_JWT_SECRET=change_me
STRAPI_JWT_SECRET=change_me
STRAPI_TRANSFER_TOKEN_SALT=change_me

# =========================================================================
# HOST PATHS
# =========================================================================

STRAPI_DB_HOST_PATH=./strapi/db
STRAPI_APP_HOST_PATH=./strapi/app

# =========================================================================
# RESOURCE LIMITS
# =========================================================================

STRAPI_DB_CPUS=1.0
STRAPI_DB_MEM_LIMIT=1024m

STRAPI_CPUS=1.0
STRAPI_MEM_LIMIT=1024m
