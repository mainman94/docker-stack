DOCKHAND_TZ=Europe/Vienna

DOCKHAND_UID=568
DOCKHAND_GID=568
# GID that owns /var/run/docker.sock on the host:
# stat -c '%g' /var/run/docker.sock
DOCKHAND_DOCKER_GID=999

DOCKHAND_WEB_PORT=30328

# Absolute host path — Dockhand deploys stacks from here via the host docker
# daemon, so it must be the same path the daemon sees. This is the dataset the
# TrueNAS app used, containing stacks/, back/, db/dockhand.db and
# .encryption_key. Keep it as-is when migrating off the TrueNAS app.
DOCKHAND_DATA_HOST_PATH=/mnt/default_pool/dockge

DOCKHAND_CPUS=2
DOCKHAND_MEM_LIMIT=4096m
