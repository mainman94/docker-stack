WEALTHFOLIO_UID=568
WEALTHFOLIO_GID=568
WEALTHFOLIO_TZ=Europe/Vienna

WEALTHFOLIO_WEB_PORT=30673

# Public origin; also the CORS origin and the base of the OIDC redirect URL.
WEALTHFOLIO_ORIGIN=https://wealth.hauptmann.dev

# openssl rand -base64 32
WEALTHFOLIO_SECRET_KEY=change-me

# Argon2id PHC string; in a .env file wrap it in single quotes so compose
# does not interpolate the "$": 'printf pw | argon2 salt16chars!!! -id -e'
WEALTHFOLIO_AUTH_PASSWORD_HASH=change-me
WEALTHFOLIO_AUTH_TOKEN_TTL_MINUTES=480

# Client from homelab terraform/pocket-id (client id and secret from Pocket ID).
WEALTHFOLIO_OIDC_ISSUER_URL=https://id.example.invalid
WEALTHFOLIO_OIDC_CLIENT_ID=change-me
WEALTHFOLIO_OIDC_CLIENT_SECRET=change-me
WEALTHFOLIO_OIDC_ALLOWED_SUBS=change-me

WEALTHFOLIO_DATA_HOST_PATH=./wealthfolio/data
WEALTHFOLIO_CPUS=1
WEALTHFOLIO_MEM_LIMIT=512m
