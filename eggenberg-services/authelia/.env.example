AUTHELIA_TZ=Europe/Vienna

AUTHELIA_UID=568
AUTHELIA_GID=568

# --- Authelia ---
AUTHELIA_DOMAIN=example.invalid
AUTHELIA_AUTH_URL=https://auth.example.invalid
AUTHELIA_AUTH_HOST=auth.example.invalid
AUTHELIA_WEB_PORT=30091

AUTHELIA_CONFIG_HOST_PATH=./authelia/config
AUTHELIA_CPUS=1
AUTHELIA_MEM_LIMIT=512m

# Secrets – jeweils mit `openssl rand -hex 32` generieren
AUTHELIA_JWT_SECRET=change-me
AUTHELIA_SESSION_SECRET=change-me
AUTHELIA_STORAGE_ENCRYPTION_KEY=change-me

# --- PostgreSQL ---
AUTHELIA_POSTGRES_DATABASE=authelia
AUTHELIA_POSTGRES_USER=authelia
AUTHELIA_POSTGRES_PASSWORD=change-me
AUTHELIA_POSTGRES_DATA_HOST_PATH=./authelia/postgres-data
AUTHELIA_POSTGRES_CPUS=1
AUTHELIA_POSTGRES_MEM_LIMIT=512m

# --- Valkey ---
AUTHELIA_REDIS_UID=568
AUTHELIA_REDIS_GID=568
AUTHELIA_REDIS_PASSWORD=change-me
AUTHELIA_REDIS_DATA_HOST_PATH=./authelia/redis-data
AUTHELIA_REDIS_CPUS=0.5
AUTHELIA_REDIS_MEM_LIMIT=256m

# --- SMTP-Benachrichtigungen ---
AUTHELIA_SMTP_HOST=smtp.example.invalid
AUTHELIA_SMTP_PORT=587
AUTHELIA_SMTP_USERNAME=authelia@example.invalid
AUTHELIA_SMTP_FROM=authelia@example.invalid
AUTHELIA_SMTP_PASSWORD=change-me
